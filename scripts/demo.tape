# VHS Demo Recording for Claude Mountaineering Skills
# Run: cd scripts && vhs demo.tape

Output ../skills/route-researcher/assets/demo.gif

# Terminal settings - sized for GitHub column readability
Set Shell bash
Set FontSize 18
Set Width 720
Set Height 520
Set Theme "Catppuccin Mocha"
Set Padding 20
Set Framerate 30
Set PlaybackSpeed 1

# Hide the command, just show the output
Hide
Type "bash demo-simulation.sh"
Enter
Sleep 100ms
Show
Sleep 48s
